<ui:ContentDialog x:Class="Kurome.Ui.Pages.Devices.IncomingPairDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:Kurome.Ui.Pages.Devices"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  ui:Design.Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                  ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                  mc:Ignorable="d"
                  Title="Pair with this device?">
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:IncomingPairDialog}" />
    </ui:ContentDialog.Resources>

    <StackPanel MaxWidth="420">
        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" CornerRadius="24"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ui:SymbolIcon Symbol="Phone24" FontSize="24"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="BodyStrong"
                              TextTrimming="CharacterEllipsis"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Text="{Binding DeviceState.Name}" />
                <ui:TextBlock FontTypography="Caption"
                              TextTrimming="CharacterEllipsis"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding DeviceState.Id}" />
            </StackPanel>
        </StackPanel>

        <ui:TextBlock Margin="0,18,0,0"
                      TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      Text="This device is asking to pair with this computer. Once paired, its storage is mounted as a drive here and it can be browsed like any other folder." />

        <ui:InfoBar Margin="0,18,0,0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    Title="Only accept devices you recognise"
                    Message="Check that the name above matches the device in your hand." />
    </StackPanel>
</ui:ContentDialog>
